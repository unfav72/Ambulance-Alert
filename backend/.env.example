# ==========================================
# Emergency Ambulance System Environment Configuration
# ==========================================

# Node Runtime Mode
NODE_ENV=development

# Server Port
PORT=5000

# PostgreSQL Connection String (Normalized Prisma schema)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ambulance_db?schema=public

# Cryptographic JWT Secret (Must be >= 32 characters in production)
JWT_SECRET=super-secret-production-grade-emergency-jwt-key-2026-secure
JWT_EXPIRES_IN=8h

# Allowed CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Dynamic Turn-by-Turn Routing & ETA Engine (OSRM or OpenRouteService)
OSRM_ROUTING_URL=https://router.project-osrm.org

# Rate Limiting Guard
ENABLE_RATE_LIMITING=true

# Initial Administrator Provisioning Setup Token (CLI bootstrap token)
ADMIN_SETUP_TOKEN=emergency-admin-initial-setup-token-secure-2026
